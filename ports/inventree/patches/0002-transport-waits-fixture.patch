+// Transport-agnostic waits (tierless corpus run protocol, test patch — applied to BOTH
+// arms; docs/corpus.md test accommodations): the ported build carries /api over a session
+// socket, so no HTTP response fires for it and pui_printing's
+// `page.waitForResponse(r => r.url().includes('/api/label/print/'))` waits forever.
+// installTransportWaits patches waitForResponse/waitForRequest on this context's pages in
+// place — the suite's own predicate runs unchanged against a truthful crossing facade; on
+// the stock build every wait reduces to the original exactly. recordForceBrowserRoutes
+// keeps route() mocks interceptable. Their playwright (1.60) seals the client classes, so
+// this rides the suite's own fixture seam instead of the zero-touch config wrapper.
+// Idempotent per context.
+async function installTierlessWaits(context: BrowserContext) {
+  await installTransportWaits(context);
+  recordForceBrowserRoutes(context);
+}
